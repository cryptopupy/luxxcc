{
  "name": "Config",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Config name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Legit",
        "Semi-Legit",
        "Blatant",
        "Rage",
        "Custom"
      ],
      "default": "Legit"
    },
    "lua_content": {
      "type": "string",
      "description": "The Lua config content"
    },
    "description": {
      "type": "string",
      "description": "Config description"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the user's active config"
    }
  },
  "required": [
    "name",
    "lua_content"
  ]
}